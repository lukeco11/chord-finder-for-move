{
  "title": "Chord Finder",
  "children": [
    {
      "title": "Play",
      "lines": [
        "Left 4 columns:",
        "notes and root focus.",
        "Shift + left pad",
        "sets a top note.",
        "",
        "Right 4 columns:",
        "ranked chord choices.",
        "Green is diatonic.",
        "Yellow is color.",
        "Brightness is rank.",
        "Auditioning does not",
        "remap the grid."
      ]
    },
    {
      "title": "Explore",
      "lines": [
        "Click the main jog",
        "to cycle modes:",
        "ROOT, NEXT, VOICE.",
        "",
        "ROOT changes chord",
        "type on one root.",
        "NEXT suggests what",
        "could follow.",
        "VOICE changes only",
        "the voicing."
      ]
    },
    {
      "title": "Piano Display",
      "lines": [
        "The lower display",
        "shows two octaves.",
        "Filled white keys",
        "and inverted black",
        "keys are sounding.",
        "",
        "Bottom markers:",
        "left is the bass,",
        "center is the root,",
        "right is the top.",
        "It follows auditions",
        "and loop playback."
      ]
    },
    {
      "title": "Root Revoice",
      "lines": [
        "Hold a right chord",
        "and press any left",
        "pad to immediately",
        "revoice it from the",
        "new root.",
        "",
        "With Capture on,",
        "the first chord and",
        "each revoice fill the",
        "next slot in order."
      ]
    },
    {
      "title": "Progression",
      "lines": [
        "Hold right + Step",
        "stores that chord.",
        "Shift + Step stores",
        "held or last chord.",
        "",
        "Delete + Step clears.",
        "Capture toggles",
        "automatic append.",
        "",
        "Tap a stored step",
        "to preview it.",
        "Tap an empty step",
        "for gap suggestions.",
        "Play arms the loop",
        "and controls Move.",
        "Once armed, Move Play",
        "works from any screen."
      ]
    },
    {
      "title": "Encoders",
      "lines": [
        "1 Key",
        "2 Scale",
        "3 Color depth",
        "4 Extension",
        "5 Inversion",
        "6 Spread",
        "7 Strum",
        "8 Loop rate",
        "",
        "Up/Down changes",
        "the octave range."
      ]
    },
    {
      "title": "MIDI Setup",
      "lines": [
        "Menu opens channel,",
        "output, preview, and",
        "gate settings.",
        "TEST OUTPUT sends a",
        "short C major chord.",
        "EXPORT CHORDS saves",
        "a preset named",
        "Chord Finder into",
        "Impressive Chords.",
        "Turn Scan Presets on",
        "there to load it.",
        "It also saves",
        "chord_finder.mid in",
        "this module's",
        "exports folder.",
        "",
        "MOVE/USB-C injects",
        "into a Move track.",
        "Set that track's MIDI",
        "In and Out to the",
        "same channel.",
        "USB-A sends directly.",
        "",
        "SCHWUNG sends preview",
        "or loop playback to",
        "matching chain slots.",
        "Schwung 0.12.0 and",
        "0.12.1 need a host",
        "update for Move output",
        "inside the takeover."
      ]
    },
    {
      "title": "Exit Safety",
      "lines": [
        "Back parks the UI.",
        "The armed progression",
        "keeps following Move",
        "while you edit tracks.",
        "",
        "Shift + Back exits.",
        "LOOP OFF is disarmed.",
        "LOOP WAIT is armed",
        "while Move is stopped.",
        "LOOP PLAY follows the",
        "current Move beat.",
        "Route changes, exit,",
        "and unload send note",
        "cleanup."
      ]
    }
  ]
}
